{
  "name": "@fiction-cms/psql",
  "version": "0.1.0",
  "description": "PostgreSQL Drizzle schemas and adapters for Fiction CMS texts and data collections.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --passWithNoTests",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@fiction-cms/common": "workspace:*",
    "@paralleldrive/cuid2": "^3.3.0",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "tsx": "^4.22.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
