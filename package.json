{
  "name": "@fiction-cms/workspace",
  "version": "1.0.0",
  "description": "A CMS designed for git repositories with Vite+React frontend and Hono backend",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently \"pnpm --filter @fiction-cms/backend dev\" \"pnpm --filter @fiction-cms/frontend dev\"",
    "build": "pnpm --filter @fiction-cms/git-engine build && pnpm --filter @fiction-cms/backend build && pnpm --filter @fiction-cms/frontend build",
    "lint": "pnpm --filter \"@fiction-cms/*\" lint",
    "test": "pnpm --filter \"@fiction-cms/*\" test",
    "type-check": "pnpm --filter \"@fiction-cms/*\" type-check"
  },
  "keywords": [
    "fiction",
    "cms",
    "vite",
    "react",
    "hono",
    "typescript"
  ],
  "author": "Bill Toshiaki Stark",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/gh-pages": "^6.1.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3"
  }
}